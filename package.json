{
  "name": "magpie-agent-trae-intl",
  "version": "0.1.0",
  "description": "Use Magpie models in Trae (International) on Windows, with native catalog synchronization and reversible configuration",
  "type": "module",
  "main": "./index.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/not502/magpie-agent-trae-intl.git"
  },
  "homepage": "https://github.com/not502/magpie-agent-trae-intl#readme",
  "bugs": {
    "url": "https://github.com/not502/magpie-agent-trae-intl/issues"
  },
  "files": [
    "trae.agent.js",
    "index.mjs",
    "cli.mjs",
    "restore.mjs",
    "src",
    "assets",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "ASSET_NOTICE.md"
  ],
  "bin": {
    "magpie-trae-intl": "./cli.mjs"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "check": "node scripts/check-syntax.mjs",
    "privacy": "node scripts/privacy-check.mjs",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "magpie": {
    "agent": "./trae.agent.js",
    "name": "Trae (International)",
    "summary": {
      "en": "Use Magpie models in Trae (International): registers each Magpie model as a local custom model and proxies chat through a loopback bridge.",
      "zh": "在 Trae 国际版中使用 Magpie 模型：把 Magpie 模型注册为本地自定义模型，并通过回环桥转发对话请求。"
    },
    "icon": "data:image/svg+xml;base64,",
    "options": {
      "port": 3499
    }
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-agent",
    "trae",
    "trae-international",
    "windows"
  ]
}
